PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/civicsync
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Optional server-side map tile provider probe. The default is the existing OpenStreetMap URL.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_PROVIDER=OpenStreetMap
MAP_TILE_TIMEOUT_MS=5000
MAP_TILE_HEALTHY_MS=1000
MAP_TILE_DEGRADED_MS=3000
MAP_TILE_CACHE_MS=120000
# Preferred for local development: absolute path to a service-account JSON file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"
